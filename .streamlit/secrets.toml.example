# Copy this file to .streamlit/secrets.toml for local development only.
# Never commit the real secrets.toml file.
GROQ_API_KEY = "YOUR_GROQ_API_KEY"
GROQ_MODEL = "openai/gpt-oss-20b"
FORMSPREE_FORM_ID = "replace_me"

# Optional. This legacy alpha can collect widget values, so this app only wraps
# a static header when enabled. Prefer Community Cloud's built-in app analytics.
ENABLE_LEGACY_ANALYTICS = false
ANALYTICS_PASSWORD = "replace_with_a_noncritical_password"

# Optional conservative overrides.
MAX_RUNS_PER_SESSION = 3
GLOBAL_LLM_REQUESTS_PER_MINUTE = 20
